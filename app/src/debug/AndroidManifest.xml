<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug-only overlay.

      Instrumented tests run against local cleartext mock HTTP servers (MockWebServer) and the
      WebView loads http://localhost. Cleartext for localhost/emulator hosts is permitted by
      network_security_config.xml, which applies to all build types, so no debug-only override
      of usesCleartextTraffic is needed here. Release builds remain HTTPS-only for everything else.
    -->

</manifest>
