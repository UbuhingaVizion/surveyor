<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".OrgActivity">

    <item
        android:id="@+id/action_search"
        android:title="@string/action_search_flows"
        app:actionViewClass="androidx.appcompat.widget.SearchView"
        app:showAsAction="ifRoom|collapseActionView" />

    <item
        android:id="@+id/action_refresh"
        android:icon="@drawable/ic_cloud_download_white_24dp"
        android:onClick="onActionRefresh"
        android:orderInCategory="1"
        android:title="@string/action_refresh"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/action_switch_org"
        android:onClick="onActionSwitchOrg"
        android:orderInCategory="2"
        android:title="@string/action_switch_org"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_org_color"
        android:onClick="onActionOrgColor"
        android:orderInCategory="3"
        android:title="@string/action_org_color"
        app:showAsAction="never" />

</menu>
