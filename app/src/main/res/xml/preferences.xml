<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_header_general">

        <EditTextPreference
            android:key="host"
            android:defaultValue="@string/pref_default_host"
            android:title="@string/pref_title_host"
            android:summary="@string/pref_summary_host"/>

        <ListPreference
            android:key="send_over"
            android:defaultValue="wifi"
            android:title="@string/pref_title_send_over"
            android:summary="@string/pref_summary_send_over"
            android:entries="@array/send_over_entries"
            android:entryValues="@array/send_over_values"/>

    </PreferenceCategory>

</PreferenceScreen>
